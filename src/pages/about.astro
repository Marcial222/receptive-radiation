---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "About Elaria";

const identity = {
  firstName:"Marcia",
  country: "USA",
  state: "California",
  occupation: "web developer",
  hobbies: ["group fitness classes", "line dancing", "reading"],
};

const skills = ["HTML", "CSS", "JavaScript",  "Astro", "Web Essays"]
const skillColor = "limegreen";
const fontWeight = "bold";
const textCase = "uppercase";
---
<BaseLayout pageTitle={pageTitle}>
	<style define:vars={{skillColor, fontWeight, textCase}}>
			h1{
				color: limegreen;
				font-size: 2.5rem;
			}
			.skill {
			  color: var(--skillColor);
			  font-weight: var(--fontWeight);
			  text-transform: var(--textCase);
			}
		</style> 
		<h1>About our Founder</h1>
	<p>Here are a few facts about Elaria's editor:</p>
<ul>
  <li>Her name is {identity.firstName}.</li>
  <li>She lives in southern {identity.state} and works as a {identity.occupation}.</li>
  {identity.hobbies.length >= 2 &&
    <li>She likes to be active, and her favorite hobbies are: {identity.hobbies[0]} and {identity.hobbies[1]}</li>
  }
</ul>
<p>My skills are:</p>
<ul>
  {skills.map((skill) => <li  class="skill">{skill}</li>)}
</ul>
</BaseLayout>


