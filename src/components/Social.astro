---
const { platform, username } = Astro.props;
---
<a href={`https://www.${platform}.com/${username}`}>{platform}</a>

<style>
    a {
        padding: 0.5rem 1rem;
        margin: 0.5rem;
        color: white;
        background-color: #1c28d0;
        text-decoration: none;
        border-radius: 10;
    }
</style>